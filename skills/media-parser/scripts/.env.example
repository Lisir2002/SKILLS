# ==============================================================================
# media-parser 技能环境变量配置示例（可选，仅小红书高级解析需要）
# 复制本文件为 .env 放在 scripts/ 目录下，填入真实值。
# 普通分享链接（抖音/快手/B站等）无需任何配置。
# ==============================================================================

# 小红书登录 Cookie（解析 xsec_source=pc_feed 等推荐流链接必备）
# 请在浏览器登录小红书后，从开发者工具复制 Cookie（必须包含 a1 字段）
XIAOHONGSHU_COOKIE=a1=your_a1_cookie_value_here; webId=your_web_id_here
