    {
      "id": "t1_new_ideas",
      "prompt": "帮我想几个有创意的营销点子",
      "must_trigger": true,
      "keywords": ["创意", "点子", "创新"]
    },
    {
      "id": "t2_break_pattern",
      "prompt": "这个方案太套路了，跳出思维定式重新想",
      "must_trigger": true,
      "keywords": ["跳出思维定式", "套路", "重新想"]
    },
    {
      "id": "t3_no_template",
      "prompt": "别模板化，给我点不一样的灵感",
      "must_trigger": true,
      "keywords": ["模板化", "灵感", "不一样"]
    },
    {
      "id": "t4_original",
      "prompt": "我要原创一点的想法，不要千篇一律的",
      "must_trigger": true,
      "keywords": ["原创", "千篇一律"]
    },
    {
      "id": "t5_negative_parse",
      "prompt": "帮我解析这个抖音链接",
      "must_trigger": false,
      "keywords": ["创新", "点子", "创意", "脑洞", "跳出思维定式", "灵感"]
    }
  ],
  "quality_evals": [
