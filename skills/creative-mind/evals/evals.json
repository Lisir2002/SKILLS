    { "id": "q3_tech_ref", "kind": "contains", "target": "SKILL.md", "text": "techniques-zh.md" },
    { "id": "q4_script_ref", "kind": "contains", "target": "SKILL.md", "text": "stereotype_scan.py" },
    { "id": "q5_script_ref2", "kind": "contains", "target": "SKILL.md", "text": "idea_scaffold.py" },
    { "id": "q6_readme_install", "kind": "contains", "target": "README.md", "text": "安装" },
    { "id": "q7_no_secret", "kind": "not_contains", "target": "SKILL.md", "text": "ghp_" },
    { "id": "q8_no_secret2", "kind": "not_contains", "target": "SKILL.md", "text": "sk_test_" },
