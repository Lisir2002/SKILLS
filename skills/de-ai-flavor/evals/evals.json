    },
    {
      "id": "t2_polish_human",
      "prompt": "这段文字AI味太重了，帮我润色得像真人写的",
      "must_trigger": true,
      "keywords": ["去ai味", "ai味", "像真人"]
    },
    {
      "id": "t3_lower_rate",
      "prompt": "帮我降一下AI率",
      "must_trigger": true,
      "keywords": ["降ai率", "ai率"]
