    {
      "id": "t4_negative_translate",
      "prompt": "帮我把这段话翻译成英文",
      "must_trigger": false,
      "keywords": ["去ai味", "ai味", "降ai率", "ai痕迹"]
    },
    {
      "id": "t5_negative_create",
      "prompt": "从零写一篇产品介绍文案",
